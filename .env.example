# Local development defaults (Docker-free). Copy to .env and adjust.
# QDRANT_URL: ./qdrant_storage = persistent local files (recommended, EXCLUSIVE
#             per-process lock — stop the API before ingest/eval);
#             :memory: = non-persistent (tests only); http://localhost:6333 = server.
QDRANT_URL=./qdrant_storage
QDRANT_COLLECTION=trustlens_chunks
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_storage
QDRANT_TIMEOUT=5
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=trustlens
NEO4J_TIMEOUT=5
GRAPH_STORE_PATH=./graph_store.json
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
SIMILARITY_METRIC=cosine
CHUNK_SIZE=200
CHUNK_OVERLAP=30
TOP_K=5
RETRIEVAL_MODE=hybrid
GRAPH_MAX_DEPTH=2
RRF_K=60
BM25_INDEX_PATH=./bm25_index.pkl
DOCUMENTS_PATH=./documents_registry.json
API_HOST=127.0.0.1
API_PORT=8000
